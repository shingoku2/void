# Void Environment Variables
# Copy this file to .env and fill in values as needed.

# =============================================================================
# DEVELOPMENT MODE
# =============================================================================

# Set to "1" when running in development mode (via npm run watch or Dev Mode)
# Used to enable development-specific features and disable certain optimizations
VSCODE_DEV=

# =============================================================================
# NLS / LOCALIZATION
# =============================================================================

# JSON string containing NLS configuration
# Format: {"locale":"en-US","availableLanguages":{"*":"en"}}
# Optional - if not set, Void will auto-detect system locale
VSCODE_NLS_CONFIG=

# =============================================================================
# CACHE
# =============================================================================

# Optional explicit path for code cache directory
# If not set, uses platform-specific default location
VSCODE_CODE_CACHE_PATH=

# =============================================================================
# PORTABLE MODE
# =============================================================================

# Set to "1" to run Void in portable mode
# In portable mode, all configuration is stored relative to the executable
VSCODE_PORTABLE=

# =============================================================================
# CLI MODE
# =============================================================================

# Set to "1" when running the CLI interface (command-line only, no GUI)
VSCODE_CLI=

# =============================================================================
# ELECTRON FLAGS
# =============================================================================

# Set to "1" to run Electron as a regular Node.js process (not as a GUI app)
# Useful for debugging or running Node.js scripts that bundle Electron
ELECTRON_RUN_AS_NODE=

# =============================================================================
# NODE.JS OPTIONS (optional, for advanced users)
# =============================================================================

# Example: Increase max old space size for large builds
# NODE_OPTIONS="--max-old-space-size=8192"

# =============================================================================
# BUILD TOOLS (set automatically by build system, do not set manually)
# =============================================================================

# Visual Studio installation path (Windows only)
# vs2022_install=C:\Program Files\Microsoft Visual Studio\2022

# Skip Node.js version check (not recommended)
# VSCODE_SKIP_NODE_VERSION_CHECK=1
