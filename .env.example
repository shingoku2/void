# Void Environment Variables
# Copy this file to .env and fill in values as needed.

# =============================================================================
# DEVELOPMENT MODE
# =============================================================================

# Set to "1" when running in development mode (via npm run watch or Dev Mode)
# Used to enable development-specific features and disable certain optimizations
VSCODE_DEV=

# =============================================================================
# NLS / LOCALIZATION
# =============================================================================

# JSON string containing NLS configuration
# Format: {"locale":"en-US","availableLanguages":{"*":"en"}}
# Optional - if not set, Void will auto-detect system locale
VSCODE_NLS_CONFIG=

# =============================================================================
# CACHE
# =============================================================================

# Optional explicit path for code cache directory
# If not set, uses platform-specific default location
VSCODE_CODE_CACHE_PATH=

# =============================================================================
# PORTABLE MODE
# =============================================================================

# Set to "1" to run Void in portable mode
# In portable mode, all configuration is stored relative to the executable
VSCODE_PORTABLE=

# =============================================================================
# CLI MODE
# =============================================================================

# Set to "1" when running the CLI interface (command-line only, no GUI)
VSCODE_CLI=

# =============================================================================
# ELECTRON FLAGS
# =============================================================================

# Set to "1" to run Electron as a regular Node.js process (not as a GUI app)
# Useful for debugging or running Node.js scripts that bundle Electron
ELECTRON_RUN_AS_NODE=

# =============================================================================
# NODE.JS OPTIONS (optional, for advanced users)
# =============================================================================

# Example: Increase max old space size for large builds
# NODE_OPTIONS="--max-old-space-size=8192"

# =============================================================================
# SIGNAL HANDLING
# =============================================================================

# Set to "1" to indicate that the process handles SIGPIPE itself.
# When set, Void will not install a SIGPIPE handler (avoids broken pipe infinite loops in Electron).
# Automatically set by the server process — do not set manually.
VSCODE_HANDLES_SIGPIPE=

# =============================================================================
# PROCESS LIFECYCLE
# =============================================================================

# Stores the current working directory for consistent lookups across processes.
# Automatically managed by bootstrap-node.ts — do not set manually.
# On Windows, also used to restore cwd after it may have escaped to a parent shell.
VSCODE_CWD=

# Parent process ID. When set, the process will exit when the parent process exits.
# Used by forked processes to terminate gracefully when the parent dies.
VSCODE_PARENT_PID=

# Set to "1" to prevent Void from installing global uncaught exception handlers.
# When unset, Void installs handlers for uncaught exceptions and unhandled promise rejections.
# Extension hosts set this to "true" to allow the main process to handle exceptions.
VSCODE_HANDLES_UNCAUGHT_ERRORS=

# =============================================================================
# LOGGING
# =============================================================================

# Set to "true" to enable verbose logging. When enabled, console.log/info/warn
# are forwarded to the parent process via IPC. When disabled, only console.error
# is shown (log/info/warn are silenced). Used by forked processes for debugging.
VSCODE_VERBOSE_LOGGING=

# Set to "true" to enable pipe logging. When enabled in a forked process,
# console output is transmitted to the parent process over IPC.
# Used by bootstrap-fork.ts to relay console logs to the main process.
VSCODE_PIPE_LOGGING=

# =============================================================================
# DEVELOPMENT
# =============================================================================

# Path to inject node module lookup paths when running out of sources.
# When VSCODE_DEV is set, this enables loading modules from a custom path.
# Automatically set by the server; can be overridden for custom development setups.
# Example: /path/to/void/remote/node_modules
VSCODE_DEV_INJECT_NODE_MODULE_LOOKUP_PATH=

# The ESM entry point module to load in forked processes.
# Example: "bootstrap-fork" (loaded as ./bootstrap-fork.js)
# Used by bootstrap-fork.ts to dynamically import the correct module.
VSCODE_ESM_ENTRYPOINT=

# =============================================================================
# CRASH REPORTING
# =============================================================================

# The process type for crash reporter configuration.
# Set to "renderer", "extensionhost", or "gpu" to configure Electron crash reporter.
# Used by bootstrap-fork.ts to add the processType extra parameter to crash reports.
VSCODE_CRASH_REPORTER_PROCESS_TYPE=

# =============================================================================
# REMOTE SERVER
# =============================================================================

# Override the server host via environment variable (fallback for --host argument).
# Used by server-main.ts to allow host override without command-line args.
VSCODE_SERVER_HOST=

# Override the server port via environment variable (fallback for --port argument).
# Used by server-main.ts to allow port override without command-line args.
VSCODE_SERVER_PORT=

# =============================================================================
# SERVER GLIBC COMPATIBILITY (Linux remote development)
# =============================================================================

# Custom glibc linker path for unsupported glibc versions.
# When set along with VSCODE_SERVER_CUSTOM_GLIBC_PATH and VSCODE_SERVER_PATCHELF_PATH,
# enables patching the server binary to work on systems with older glibc.
VSCODE_SERVER_CUSTOM_GLIBC_LINKER=

# Custom glibc library path for patching.
VSCODE_SERVER_CUSTOM_GLIBC_PATH=

# Path to the patchelf tool for patching the server binary.
VSCODE_SERVER_PATCHELF_PATH=

# =============================================================================
# BUILD TOOLS (set automatically by build system, do not set manually)
# =============================================================================

# Visual Studio installation path (Windows only)
# vs2022_install=C:\Program Files\Microsoft Visual Studio\2022

# Skip Node.js version check (not recommended)
# VSCODE_SKIP_NODE_VERSION_CHECK=1
